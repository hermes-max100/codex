# Add to ~/.codex/config.toml. Everyday sessions run on the balanced model; subagents
# start on the cheapest model and only go higher when spawn_agent asks for it.
model = "gpt-5.6-terra"
model_reasoning_effort = "medium"

[agents]
default_subagent_model = "gpt-5.6-luna"
default_subagent_reasoning_effort = "low"
